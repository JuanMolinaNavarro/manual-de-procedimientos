generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Padrón de abonados importado desde Excel, para control de duplicados
// (búsqueda por documento, nombre o domicilio). Se reemplaza en cada carga.
model PadronAbonado {
  id                  Int      @id @default(autoincrement())
  // Default 'CCC' para backfillear el padrón CCC ya cargado al introducir la
  // columna (db push no puede agregar NOT NULL sin default a una tabla con datos).
  // El código siempre setea la empresa explícita en cada carga.
  empresa             String   @default("CCC")
  codigo              String?
  nombre_completo     String?
  estado              String?
  domicilio           String?
  domicilio_info_adic String?
  documento_numero    String?
  // "Importe Saldo Comprobantes" del Excel. Decimal (no String) porque es dinero:
  // admite negativos (notas de crédito) y permite ordenar/filtrar por importe.
  saldo               Decimal? @db.Decimal(14, 2)
  created_at          DateTime @default(now())

  @@index([empresa, documento_numero])
  @@index([empresa, codigo])
  @@map("padron_abonados")
}

model Bonificacion {
  id               Int      @id @default(autoincrement())
  empresa          String
  titulo           String
  descripcion      String?
  mensaje_sugerido String?
  condiciones      String?
  activa           Boolean  @default(true)
  vigencia_desde   String?
  vigencia_hasta   String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("bonificaciones")
}

model MwproxyCatalog {
  id          Int       @id @default(autoincrement())
  mwproxy_id  Int       @unique
  name        String
  year        Int?
  available   Boolean   @default(false)
  imdb_id     String?
  imdb_rating Float?
  imdb_votes  Int?
  enriched_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("mwproxy_catalog")
}

model OnDemand {
  id          Int      @id @default(autoincrement())
  imdbID      String   @unique
  title       String
  year        String
  poster      String?
  background  String?
  logo        String?
  imdb_rating Float?
  imdb_votes  Int?
  isActive    Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("on_demand")
}

model Usuario {
  id           Int          @id @default(autoincrement())
  usuario      String       @unique
  password     String
  nombre       String?
  apellido     String?
  rol          String       @default("agente")
  isActive     Boolean      @default(true)
  modulos      String[]     @default([])
  modulos_edit String[]     @default([])
  // Vínculo con la ficha del organigrama (1 a 1). SetNull: borrar la ficha
  // deja al usuario "sin vincular", nunca lo borra ni lo bloquea.
  empleado_id  Int?         @unique
  empleado     OrgEmpleado? @relation("UsuarioEmpleado", fields: [empleado_id], references: [id], onDelete: SetNull)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  sesiones     Sesion[]
  // Bloqueo de login por contraseñas incorrectas (ver src/lib/login-limite.ts).
  login_fallos         Int       @default(0)
  login_bloqueado_hasta DateTime?

  @@map("usuarios")
}

// Sesión del panel. La cookie `site_session` lleva un token aleatorio; acá se guarda solo su
// sha256 (si se filtra la base no hay sesiones vivas que robar). Rol, estado y permisos se leen
// SIEMPRE del Usuario, nunca de la cookie. Ver src/lib/sesion.ts.
model Sesion {
  id         String    @id // sha256 hex del token de la cookie
  usuario_id Int
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  expira     DateTime
  revocada   DateTime?
  ip         String?
  user_agent String?
  created_at DateTime  @default(now())

  @@index([usuario_id])
  @@map("sesiones")
}

model SportsEvent {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  synced_at        DateTime @default(now())

  @@map("sports_events")
}

model SportsFeatured {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  type             String
  borderColor      String
  synced_at        DateTime @default(now())

  @@map("sports_featured")
}

model Lead {
  id         Int      @id @default(autoincrement())
  nombre     String?
  apellido   String?
  telefono   String
  email      String?
  direccion  String?
  plan       String?
  tv_pack    Boolean? @default(false)
  origen     String
  contactado Boolean? @default(false)
  resultado  String?
  asignado   String?
  created_at DateTime @default(now())
  @@index([created_at])

  @@map("leads")
}

model PlanConfig {
  id             Int      @id @default(autoincrement())
  empresa        String   @unique
  plans          Json
  tv_addon_price Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("plan_configs")
}

model ContratoComprador {
  id                         Int      @id @default(autoincrement())
  nombre_empresa             String
  ejecutivo_a_cargo          String?
  mail_comercial             String?
  telefono_comercial         String?
  mail_tecnico               String?
  telefono_tecnico           String?
  vigencia_desde             String?
  vigencia_hasta             String?
  precio_tipo                String?
  precio_valor               String?
  subs_minimo_garantizado    String?
  reportar_subs              Boolean  @default(false)
  plazas_reportadas          String?
  condiciones_pago_contrato  String?
  condiciones_pago_acordadas String?
  tnb_aplicada               String?
  tecnologias_autorizadas    String[] @default([])
  logo_nombre_archivo        String?
  activa                     Boolean  @default(true)
  created_by                 String?
  updated_by                 String?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  saltos_importe SaltoImporte[]
  archivos       ArchivoContrato[]

  @@map("contratos_comprador")
}

model ContratoVendedor {
  id                               Int      @id @default(autoincrement())
  nombre_empresa                   String
  documentacion_empresa            String?
  ejecutivo_cargo                  String?
  mail_comercial_cliente           String?
  telefono_comercial_cliente       String?
  mail_tecnico_cliente             String?
  telefono_tecnico_cliente         String?
  vigencia_desde                   String?
  vigencia_hasta                   String?
  precio_tipo                      String?
  precio_valor                     String?
  grilla                           String?
  subs_minimo_garantizado          String?
  subs_reportados_senales          String?
  plazas_incluidas_contrato        String?
  plazas_reportadas_senales        String?
  condiciones_pago                 String?
  tnb_aplicada                     String?
  forma_recepcion_entrega          String?
  equipos_por_senal                Json?
  condiciones_entrega_equipamiento String?
  logo_nombre_archivo              String?
  activa                           Boolean  @default(true)
  created_by                       String?
  updated_by                       String?
  created_at                       DateTime @default(now())
  updated_at                       DateTime @updatedAt

  saltos_importe SaltoImporte[]
  archivos       ArchivoContrato[]

  @@map("contratos_vendedor")
}

model SaltoImporte {
  id                    Int       @id @default(autoincrement())
  contrato_comprador_id Int?
  contrato_vendedor_id  Int?
  descripcion           String
  fecha_efectiva        String
  dias_aviso_previo     Int       @default(30)
  nuevo_precio          String?
  notificado_at         DateTime?
  activa                Boolean   @default(true)
  created_by            String?
  updated_by            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  contrato_comprador ContratoComprador? @relation(fields: [contrato_comprador_id], references: [id])
  contrato_vendedor  ContratoVendedor?  @relation(fields: [contrato_vendedor_id], references: [id])
  @@index([contrato_comprador_id])
  @@index([contrato_vendedor_id])

  @@map("saltos_importe")
}

model ArchivoContrato {
  id                    Int      @id @default(autoincrement())
  contrato_comprador_id Int?
  contrato_vendedor_id  Int?
  nombre_original       String
  nombre_archivo        String
  tipo_mime             String?
  tamano                Int?
  created_by            String?
  created_at            DateTime @default(now())

  contrato_comprador ContratoComprador? @relation(fields: [contrato_comprador_id], references: [id], onDelete: Cascade)
  contrato_vendedor  ContratoVendedor?  @relation(fields: [contrato_vendedor_id], references: [id], onDelete: Cascade)
  @@index([contrato_comprador_id])
  @@index([contrato_vendedor_id])

  @@map("archivos_contrato")
}

// ─── Organigrama corporativo ────────────────────────────────────────────────
// Modelo híbrido: campos clave como columnas escalares (consultables/integrables)
// y el "CV" rico como columnas Json. Reemplaza las 4 claves de localStorage del
// HTML original por una única fuente de verdad compartida en Postgres.

model Organigrama {
  id         Int      @id @default(autoincrement())
  nombre     String // empresa o ubicación
  direccion  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Nómina: cada organigrama (empresa/ubicación) liquida por separado.
  nomina_config          NominaConfig?
  nomina_conceptos       NominaConcepto[]
  nomina_bonos           NominaBono[]
  nomina_bonos_otorgados NominaBonoOtorgado[]
  nomina_cierres         NominaCierre[]
  nomina_adhesiones      NominaAdhesion[]
  nomina_constancias     NominaConstancia[]

  @@map("organigramas")
}

model OrgEmpleado {
  id               Int     @id @default(autoincrement())
  organigrama_id   Int? // empresa/ubicación a la que pertenece
  nombre           String
  rol              String
  area             String // == OrgArea.nombre
  manager_id       Int?
  email            String?
  telefono         String? // interno ("phone")
  foto_archivo     String? // filename en uploads/organigrama/fotos
  estado           String  @default("active") // active | inactive
  sede             String?
  modalidad        String?
  guardias         String?
  actualizado      String?
  summary          String?
  antiguedad       String?
  formacion        String?
  seniority        String?
  especialidad     String?
  // ISO yyyy-mm-dd (string como todas las fechas de dominio; evita corrimientos UTC)
  fecha_nacimiento String?

  // CV (Json) — espejo de las arrays del HTML
  experiencia        Json? // [{role,company,period,gray?}]
  resp_primarias     Json? // string[]
  resp_secundarias   Json? // string[]
  inputs             Json? // string[]
  outputs            Json? // string[]
  hard_skills        Json? // [{name,level,label}]
  soft_skills        Json? // [{name,rating}]
  skills             Json? // string[]
  projects           Json? // string[]

  // estado del lienzo (posición libre arrastrada; null = anclado a su área)
  free_x Float?
  free_y Float?

  manager      OrgEmpleado?  @relation("OrgJerarquia", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinados OrgEmpleado[] @relation("OrgJerarquia")

  // Proyectos y finanzas: de qué está a cargo esta persona. Alimenta la pestaña
  // "Proyectos" de su ficha en el organigrama.
  proyectos_a_cargo Proyecto[]      @relation("ProyectoResponsable")
  etapas_a_cargo    ProyectoEtapa[] @relation("EtapaResponsable")

  // Cuenta de usuario vinculada a esta ficha (si la hay).
  usuario Usuario? @relation("UsuarioEmpleado")

  // Documentación de procedimientos del rol (pestaña "Documentación" de la ficha).
  documentos OrgDocumento[]

  // Licencias de software asignadas (pestaña "Licencias" de la ficha).
  licencias OrgLicencia[]

  // Nómina: datos estables (maestro), novedades mensuales, liquidaciones cerradas,
  // adhesión al recibo digital y constancias de firma. Liquidaciones, adhesión y
  // constancias son Restrict: una ficha con historial de nómina no se borra.
  nomina                 NominaEmpleado?
  nomina_novedades       NominaNovedad[]
  nomina_liquidaciones   NominaLiquidacion[]
  nomina_adhesion        NominaAdhesion?
  nomina_constancias     NominaConstancia[]
  nomina_recibos_pdf     NominaReciboPdf[]
  nomina_bonos_otorgados NominaBonoOtorgado[]

  // Asistencia: personas del reloj biométrico vinculadas a esta ficha y el
  // horario esperado (versionado por vigencia) contra el que se mide.
  asistencia_personas AsistenciaPersona[]
  asistencia_horarios AsistenciaHorario[]

  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@index([organigrama_id])
  @@index([manager_id])

  @@map("org_empleados")
}

// Documento de procedimientos de la ficha de un empleado. El archivo físico vive
// en uploads/organigrama/documentos (mismo criterio que las fotos); acá va la
// metadata. `categoria` es un rubro libre por el que se agrupa la lista.
model OrgDocumento {
  id              Int      @id @default(autoincrement())
  empleado_id     Int
  categoria       String   @default("General")
  titulo          String
  nombre_original String
  nombre_archivo  String // filename (uuid) en uploads/organigrama/documentos
  tipo_mime       String?
  tamano          Int?
  created_by      String?
  created_at      DateTime @default(now())

  empleado OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@index([empleado_id])
  @@map("org_documentos")
}

// Licencia de software asignada a un empleado (pestaña "Licencias" de la ficha).
// Solo la ven/cargan quienes pueden editar el organigrama (superadmin o admin
// con `modulos_edit`). El ícono físico vive en uploads/organigrama/licencias;
// `icono_origen` dice si vino del favicon del sitio ('favicon') o lo subió
// alguien ('subido'): un ícono subido nunca se pisa al cambiar la URL.
model OrgLicencia {
  id            Int      @id @default(autoincrement())
  empleado_id   Int
  titulo        String
  cuenta        String // usuario o mail al que está vinculada
  password      String? // clave de la cuenta (texto plano, como Usuario.password)
  sitio_url     String? // URL/dominio del proveedor (origen del favicon)
  icono_archivo String? // filename (uuid.ext) en uploads/organigrama/licencias
  icono_origen  String? // 'favicon' | 'subido' | null
  costo         Float?
  moneda        String? // USD | ARS
  periodicidad  String? // mensual | anual | unica
  created_by    String?
  updated_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  empleado OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@index([empleado_id])
  @@map("org_licencias")
}

model OrgArea {
  id             Int      @id @default(autoincrement())
  organigrama_id Int? // empresa/ubicación a la que pertenece
  nombre         String
  color          String   @default("#86868b")
  is_top         Boolean  @default(false)
  jefe_id        Int? // empleado jefe del área (sin relación FK formal; se limpia por código)
  parent_id      Int? // área de la que depende (sub-área); sin FK formal, se limpia por código
  pos_x          Float? // override de posición manual del área
  pos_y          Float?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // El nombre del área es único POR organigrama (dos empresas pueden tener "RRHH").
  @@unique([organigrama_id, nombre])
  @@map("org_areas")
}

model OrgLinea {
  id             Int      @id @default(autoincrement())
  organigrama_id Int? // empresa/ubicación a la que pertenece
  from_id        Int
  to_id          Int
  tipo           String   @default("special") // special | report-override
  estilo         String   @default("solid") // solid | dashed | dotted
  color          String   @default("#86868b")
  etiqueta       String?
  created_at     DateTime @default(now())
  @@index([from_id])
  @@index([to_id])

  @@map("org_lineas")
}

// ─── Proyectos y finanzas ───────────────────────────────────────────────────
// Gestión genérica de proyectos: cronograma de etapas (Gantt con dependencias),
// costos por categoría/etapa y análisis financiero en USD constantes.

model Proyecto {
  id             Int     @id @default(autoincrement())
  nombre         String
  descripcion    String?
  // Responsable: `responsable_id` apunta al organigrama y tiene precedencia;
  // `responsable` es el texto libre de respaldo para gente que no está ahí.
  responsable    String?
  responsable_id Int?
  // planificado | en_curso | pausado | terminado | cancelado
  estado         String  @default("planificado")
  // == OrgArea.nombre (string denormalizado, mismo criterio que OrgEmpleado.area).
  // Define qué usuarios ven el proyecto: admin vinculado a un área solo ve la suya.
  area           String?
  fecha_inicio   String // ISO yyyy-mm-dd
  notas          String?

  // Supuestos de ingresos del análisis financiero. Los costos salen de las
  // líneas de ProyectoCosto; acá va lo que el proyecto va a facturar o ahorrar.
  ingreso_estimado Float  @default(0)
  otros_ingresos   Float  @default(0)
  moneda_ingreso   String @default("USD") // USD | ARS
  // Año en que se cobra el ingreso: define el deflactado a USD constantes.
  anio_ingreso     Int

  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  costos          ProyectoCosto[]
  etapas          ProyectoEtapa[]
  responsable_emp OrgEmpleado?    @relation("ProyectoResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)

  @@index([responsable_id])
  @@map("proyectos")
}

model ProyectoCosto {
  id             Int    @id @default(autoincrement())
  proyecto_id    Int
  // Rubro libre por el que se agrupa la tabla (Mano de obra, Materiales, …).
  categoria      String @default("General")
  concepto       String
  unidad         String @default("unidad")
  cantidad       Float  @default(1)
  costo_unitario Float  @default(0)
  moneda         String @default("USD") // USD | ARS
  // Imputación opcional a una etapa del cronograma.
  etapa_id       Int?
  orden          Int    @default(0)

  proyecto Proyecto       @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  etapa    ProyectoEtapa? @relation(fields: [etapa_id], references: [id], onDelete: SetNull)

  @@index([proyecto_id])
  @@map("proyecto_costos")
}

model ProyectoEtapa {
  id             Int     @id @default(autoincrement())
  proyecto_id    Int
  nombre         String
  // Ídem Proyecto: el vínculo al organigrama tiene precedencia sobre el texto.
  responsable    String?
  responsable_id Int?
  fecha_inicio   String // ISO yyyy-mm-dd
  duracion_dias  Int     @default(15)
  // Etapa de la que depende: moverla arrastra a sus dependientes en cascada.
  dep_id         Int?
  estado         String  @default("pendiente") // pendiente | curso | hecho | atrasado
  avance         Int     @default(0) // 0–100 %
  orden          Int     @default(0)
  notas          String?

  proyecto        Proyecto        @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  dep             ProyectoEtapa?  @relation("EtapaDep", fields: [dep_id], references: [id], onDelete: SetNull)
  dependientes    ProyectoEtapa[] @relation("EtapaDep")
  costos          ProyectoCosto[]
  responsable_emp OrgEmpleado?    @relation("EtapaResponsable", fields: [responsable_id], references: [id], onDelete: SetNull)

  @@index([proyecto_id])
  @@index([responsable_id])
  @@map("proyecto_etapas")
}

// Singleton (id = 1): parámetros de moneda e inflación comunes a todos los proyectos.
model ProyectoConfig {
  id         Int      @id @default(1)
  fx_ars     Float    @default(1100) // ARS por USD
  infl_usd   Float    @default(3) // inflación anual del dólar (CPI EE.UU.), %
  anio_base  Int // año base para USD constantes
  updated_by String?
  updated_at DateTime @updatedAt

  @@map("proyecto_config")
}

// ─── Nómina (liquidación de sueldos) ─────────────────────────────────────────
// Todo se escopea por organigrama (empresa/ubicación). Fechas de dominio como
// String ISO; dinero como Float (criterio del repo); snapshots en Json. Los
// hashes de recibo se calculan sobre JSON canónico (claves ordenadas) porque
// jsonb no conserva el orden de las claves.

// Parámetros del motor y datos del empleador (una fila por organigrama; se
// crea sola al primer acceso y se mergea sobre los defaults al leer).
model NominaConfig {
  id             Int      @id @default(autoincrement())
  organigrama_id Int      @unique
  params         Json
  empresa        Json
  updated_by     String?
  updated_at     DateTime @updatedAt

  organigrama Organigrama @relation(fields: [organigrama_id], references: [id], onDelete: Cascade)

  @@map("nomina_configs")
}

// Conceptos adicionales propios de la empresa: los activos aplican a todos los
// empleados incluidos.
model NominaConcepto {
  id             Int     @id @default(autoincrement())
  organigrama_id Int
  nombre         String
  tipo           String // rem | norem | ded
  calculo        String // monto | pct_basico | pct_rem
  valor          Float   @default(0)
  activo         Boolean @default(false)
  orden          Int     @default(0)

  organigrama Organigrama @relation(fields: [organigrama_id], references: [id], onDelete: Cascade)

  @@index([organigrama_id])
  @@map("nomina_conceptos")
}

// Catálogo de bonos y reconocimientos (gamification del Tablero).
model NominaBono {
  id             Int     @id @default(autoincrement())
  organigrama_id Int
  nombre         String
  ambito         String  @default("empresa") // 'empresa' | nombre de área
  metrica        String // racha_presentismo | horas_extra | comisiones | premios
  monto          Float   @default(0)
  activo         Boolean @default(true)
  orden          Int     @default(0)

  organigrama Organigrama          @relation(fields: [organigrama_id], references: [id], onDelete: Cascade)
  otorgados   NominaBonoOtorgado[]

  @@index([organigrama_id])
  @@map("nomina_bonos")
}

model NominaBonoOtorgado {
  id             Int      @id @default(autoincrement())
  organigrama_id Int
  periodo        String // YYYY-MM
  bono_id        Int? // SetNull: el medallero sobrevive al borrado del bono
  bono_nombre    String
  empleado_id    Int
  monto          Float    @default(0)
  fecha          String // ISO yyyy-mm-dd
  created_by     String?
  created_at     DateTime @default(now())

  organigrama Organigrama @relation(fields: [organigrama_id], references: [id], onDelete: Cascade)
  bono        NominaBono? @relation(fields: [bono_id], references: [id], onDelete: SetNull)
  empleado    OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@unique([organigrama_id, periodo, bono_id])
  @@index([empleado_id])
  @@map("nomina_bonos_otorgados")
}

// "Maestro": datos estables de nómina de una ficha del organigrama. Nombre, rol,
// área y foto se leen del organigrama (fuente de verdad).
model NominaEmpleado {
  id            Int      @id @default(autoincrement())
  empleado_id   Int      @unique
  cuil          String   @default("")
  fecha_ingreso String   @default("") // ISO yyyy-mm-dd o ''
  basico        Float    @default(0)
  categoria     String   @default("")
  convenio      String   @default("Fuera de convenio")
  cct           String   @default("")
  afiliado      Boolean  @default(false)
  obra_social   String   @default("")
  cbu           String   @default("")
  incluir       Boolean  @default(true)
  updated_by    String?
  updated_at    DateTime @updatedAt

  empleado OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@map("nomina_empleados")
}

// Novedades del mes por empleado (lo único que cambia mes a mes).
model NominaNovedad {
  id              Int      @id @default(autoincrement())
  empleado_id     Int
  periodo         String // YYYY-MM
  he50            Float    @default(0)
  he100           Float    @default(0)
  faltas_inj      Float    @default(0)
  dias_sin_goce   Float    @default(0)
  dias_vacaciones Float    @default(0)
  comisiones      Float    @default(0)
  premios         Float    @default(0)
  sac             Float    @default(0)
  asig_familiares Float    @default(0)
  ganancias       Float    @default(0)
  adelantos       Float    @default(0)
  embargos        Float    @default(0)
  notas           String   @default("")
  updated_by      String?
  updated_at      DateTime @updatedAt

  empleado OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@unique([empleado_id, periodo])
  @@index([periodo])
  @@map("nomina_novedades")
}

// Cierre de un período: snapshot inmutable de parámetros, empleador y
// liquidaciones. `fecha_cierre` entra en el hash de cada recibo.
model NominaCierre {
  id               Int      @id @default(autoincrement())
  organigrama_id   Int
  periodo          String // YYYY-MM
  fecha_cierre     String // ISO datetime
  params_snapshot  Json
  empresa_snapshot Json
  created_by       String?
  created_at       DateTime @default(now())

  organigrama   Organigrama         @relation(fields: [organigrama_id], references: [id], onDelete: Restrict)
  liquidaciones NominaLiquidacion[]

  @@unique([organigrama_id, periodo])
  @@map("nomina_cierres")
}

model NominaLiquidacion {
  id               Int    @id @default(autoincrement())
  cierre_id        Int
  empleado_id      Int
  nombre           String
  rol              String @default("")
  area             String @default("")
  maestro_snapshot Json // {cuil, categoria, convenio, cct, fechaIngreso, cbu}
  liquidacion      Json // Liquidacion completa (rem/norem/ded/contribs/totales/flags/anios/basico)
  neto             Float
  costo_empresa    Float
  hash             String // sha256(canonicalJson(reciboPayload)) al cerrar

  cierre   NominaCierre @relation(fields: [cierre_id], references: [id], onDelete: Cascade)
  empleado OrgEmpleado  @relation(fields: [empleado_id], references: [id], onDelete: Restrict)

  @@unique([cierre_id, empleado_id])
  @@index([empleado_id])
  @@map("nomina_liquidaciones")
}

// Adhesión al recibo digital: acto único por persona. Se guarda solo el hash del
// PIN. El acta firmada en papel se escanea y se adjunta como PDF
// (uploads/nomina/actas).
model NominaAdhesion {
  id                   Int       @id @default(autoincrement())
  empleado_id          Int       @unique
  organigrama_id       Int
  codigo               String?   @unique // ADH-000123-<8 hex>: se imprime en el acta y ata papel ↔ registro
  fecha                String // ISO yyyy-mm-dd
  modo                 String    @default("papel") // siempre papel: la adhesión es presencial, con acta firmada
  cuil                 String // CUIL congelado al adherir (entra en el hash del PIN)
  email                String? // email que el trabajador declara en el acta para los avisos de recibos
  pin_hash             String // scrypt$N$r$p$salt$hash (nomina-pin.ts); nunca el PIN
  pin_cambiado         String? // ISO datetime
  pin_cambiado_por     String?
  pin_fallos           Int       @default(0) // PIN incorrectos seguidos (bloqueo persistente)
  pin_bloqueado_hasta  DateTime?
  acta_archivo         String? // <uuid>.pdf en uploads/nomina/actas. Sin acta: adhesión PENDIENTE (no firma)
  acta_nombre_original String?
  acta_tamano          Int?
  acta_sha256          String? // hash del escaneo del acta firmada en papel
  acta_subida_en       DateTime?
  created_by           String?
  created_at           DateTime  @default(now())

  empleado    OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Restrict)
  organigrama Organigrama @relation(fields: [organigrama_id], references: [id], onDelete: Restrict)

  @@map("nomina_adhesiones")
}

// Constancia de recepción y firma electrónica de un recibo. Encadenada con la
// anterior del mismo organigrama (chain_hash). Sin FK a NominaLiquidacion a
// propósito: reabrir un período (borra el cierre) conserva la constancia y al
// re-cerrar se marca "hash no coincide".
model NominaConstancia {
  id             Int      @id @default(autoincrement())
  organigrama_id Int
  periodo        String // copia del recibo (listados)
  empleado_id    Int
  recibo_id      String   @unique // NominaReciboPdf firmado: una constancia por recibo
  hash           String // SHA-256 del PDF del recibo, byte a byte
  prev_hash      String
  chain_hash     String
  fecha          String // ISO datetime (generada dentro del lock de la cadena)
  conformidad    String // conforme | disconforme
  observaciones  String   @default("")
  canal          String   @default("portal") // portal: el trabajador firma desde su celular con usuario + PIN
  firmante       Json // {empId, nombre, cuil, adhesion}
  dispositivo    String   @default("")
  ip             String   @default("") // IP desde la que firmó
  leido          Boolean  @default(true)
  created_at     DateTime @default(now())

  organigrama Organigrama       @relation(fields: [organigrama_id], references: [id], onDelete: Restrict)
  empleado    OrgEmpleado       @relation(fields: [empleado_id], references: [id], onDelete: Restrict)
  recibo      NominaReciboPdf   @relation(fields: [recibo_id], references: [id], onDelete: Restrict)
  caso        NominaCasoRecibo?

  @@index([organigrama_id, fecha])
  @@index([organigrama_id, periodo])
  @@map("nomina_constancias")
}

// ─── Recibos de sueldo emitidos por Finnegans (PDF oficial) ─────────────────
// El recibo legal lo emite Finnegans; Aurelius lo distribuye. Ver CLAUDE.md
// "Recibos de Finnegans". Independiente del motor propio (NominaCierre).

// Una liquidación de Finnegans (transacción del subtipo LIQSUELDOS): una empresa,
// un tipo de liquidación y un período, con N legajos. Sale de RESUMENLIQ.
model NominaFinnLiquidacion {
  id               Int       @id @default(autoincrement())
  transaccion_id   Int       @unique // TRANSACCIONID = primaryKey de report/execute
  organigrama_id   Int? // organigrama cuyo NominaConfig.empresa.cuit == empresa_cuit
  empresa_cuit     String
  empresa_nombre   String
  nro_liquidacion  Int
  tipo_liquidacion String
  periodo          String // yyyy-mm (de FECHAHASTA)
  fecha_desde      String // ISO yyyy-mm-dd
  fecha_hasta      String
  fecha_pago       String    @default("")
  legajos          Int
  filas            Json // filas de RESUMENLIQ de esta transacción (una por legajo)
  estado           String    @default("pendiente") // pendiente | importada | con_diferencias
  diferencias      Json?
  sabana_archivo   String? // <transaccion_id>.pdf en uploads/nomina/sabanas
  sabana_sha256    String?
  importada_en     DateTime?
  importada_por    String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  recibos NominaReciboPdf[]

  @@index([organigrama_id, periodo])
  @@index([periodo])
  @@map("nomina_finn_liquidaciones")
}

// El recibo de una persona: una o más páginas de la sábana, guardadas como PDF propio.
model NominaReciboPdf {
  id                    String    @id @default(uuid()) // opaco: es el que viaja en la URL
  liquidacion_id        Int
  organigrama_id        Int
  empleado_id           Int
  liquidacion_legajo_id Int       @unique // LIQUIDACIONLEGAJOID de Finnegans
  cuil                  String
  periodo               String // yyyy-mm
  tipo_liquidacion      String
  neto                  Float
  pagina                Int // primera página dentro de la sábana (1-based)
  archivo               String // <yyyy>/<uuid>.pdf en uploads/nomina/recibos
  sha256                String // SHA-256 del PDF byte a byte
  bytes                 Int
  estado                String    @default("disponible") // disponible | accedido | firmado | papel ("no retirado" se deriva)
  accedido_en           DateTime?
  notificado_en         DateTime? // primer aviso por mail: desde acá corren los 15 días de "no retirado"
  papel_archivo         String? // escaneo del recibo impreso y firmado a mano (uploads/nomina/papel)
  papel_sha256          String?
  papel_registrado_en   DateTime?
  papel_registrado_por  String?
  created_at            DateTime  @default(now()) // publicación = puesta a disposición

  liquidacion NominaFinnLiquidacion @relation(fields: [liquidacion_id], references: [id], onDelete: Restrict)
  empleado    OrgEmpleado           @relation(fields: [empleado_id], references: [id], onDelete: Restrict)
  constancia  NominaConstancia?

  @@index([empleado_id])
  @@index([organigrama_id, periodo])
  @@map("nomina_recibos_pdf")
}

// Adhesión revocada (o renovada porque el trabajador olvidó su PIN). Se archiva en vez de
// borrarse: el acta escaneada es el respaldo de las firmas hechas con esa adhesión y se
// conserva junto con su código (el que figura en `NominaConstancia.firmante.adhesion`).
model NominaAdhesionRevocada {
  id                   Int      @id @default(autoincrement())
  empleado_id          Int
  organigrama_id       Int
  codigo               String?
  fecha                String // fecha de la adhesión original (yyyy-mm-dd)
  cuil                 String
  acta_archivo         String?
  acta_nombre_original String?
  acta_sha256          String?
  adherida_por         String?
  adherida_en          DateTime
  revocada_en          DateTime @default(now())
  revocada_por         String?
  motivo               String   @default("")

  @@index([empleado_id])
  @@map("nomina_adhesiones_revocadas")
}

// Cada cambio de PIN. Solo por autogestión del trabajador (portal, con su PIN actual):
// RR.HH. no puede cambiar PINs. Si lo olvida, se renueva la adhesión (presencial, acta nueva).
model NominaPinCambio {
  id              Int      @id @default(autoincrement())
  empleado_id     Int
  codigo_adhesion String?
  canal           String   @default("portal")
  dispositivo     String   @default("")
  usuario         String?
  fecha           DateTime @default(now())

  @@index([empleado_id])
  @@map("nomina_pin_cambios")
}

// Disconformidad de una firma: la sigue RR.HH. (reunión, ajuste). La constancia nunca
// se modifica; la resolución se anota acá.
model NominaCasoRecibo {
  id             Int       @id @default(autoincrement())
  constancia_id  Int       @unique
  organigrama_id Int
  empleado_id    Int
  estado         String    @default("abierto") // abierto | resuelto
  notas          String    @default("")
  resuelto_en    DateTime?
  resuelto_por   String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  constancia NominaConstancia @relation(fields: [constancia_id], references: [id], onDelete: Restrict)

  @@index([organigrama_id, estado])
  @@map("nomina_casos_recibo")
}

// Aviso por mail "tus recibos están disponibles" (botón de RR.HH. por empresa y período).
// Sin adjuntos ni importes: solo el enlace al portal, donde se firman. Cada envío queda
// registrado con sus destinatarios: es la prueba de la puesta a disposición.
model NominaAviso {
  id             Int      @id @default(autoincrement())
  organigrama_id Int
  periodo        String
  modo           String // smtp | prueba (sin SMTP configurado: se guarda el .eml y no se envía)
  enviados       Int
  fallidos       Int
  enviado_por    String?
  created_at     DateTime @default(now())

  destinatarios NominaAvisoDestinatario[]

  @@index([organigrama_id, periodo])
  @@map("nomina_avisos")
}

model NominaAvisoDestinatario {
  id          Int    @id @default(autoincrement())
  aviso_id    Int
  empleado_id Int
  email       String
  recibos     Int // recibos pendientes que incluía el aviso
  estado      String // enviado | error
  error       String @default("")
  message_id  String @default("")

  aviso NominaAviso @relation(fields: [aviso_id], references: [id], onDelete: Cascade)

  @@index([empleado_id])
  @@map("nomina_aviso_destinatarios")
}

// Cada interacción PAGA con la API de Finnegans (reportes y report/execute).
// Sirve para ver el consumo del mes y cortar al llegar a FINNEGANS_TOPE_MENSUAL.
model NominaFinnLlamada {
  id       Int      @id @default(autoincrement())
  endpoint String
  detalle  String   @default("")
  ok       Boolean
  http     Int?
  usuario  String?
  fecha    DateTime @default(now())

  @@index([fecha])
  @@map("nomina_finn_llamadas")
}

// ─── Asistencia (relojes biométricos Anviz) ────────────────────────────────

// Un reloj de fichadas. `device_id` es el ID de dispositivo del protocolo TC-B
// (= ClientNumber en CrossChex) y va en la cabecera de cada trama.
model AsistenciaReloj {
  id             Int       @id @default(autoincrement())
  nombre         String
  ip             String
  puerto         Int       @default(5010)
  device_id      Int       @unique
  activo         Boolean   @default(true)
  // Borrar la marca de "nuevos" en el reloj después de bajar (cmd 0x4E). Apagado
  // mientras CrossChex siga descargando: si lo borramos nosotros, CrossChex no
  // los ve más.
  limpiar_nuevos Boolean   @default(false)
  ultimo_sync    DateTime?
  ultimo_error   String?
  reg_total      Int?
  reg_nuevos     Int?
  usuarios       Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  fichadas AsistenciaFichada[]

  @@map("asistencia_relojes")
}

// Persona tal como existe en los relojes (`user_id` = ID en el reloj, casi
// siempre el DNI). El nombre del reloj viene truncado a 10 caracteres; si está
// vinculada a una ficha del organigrama se muestra el nombre de la ficha.
model AsistenciaPersona {
  id           Int      @id @default(autoincrement())
  user_id      String   @unique
  nombre_reloj String   @default("")
  empleado_id  Int?
  // Solo manda cuando la persona NO está vinculada: si tiene ficha, la
  // actividad la decide `OrgEmpleado.estado` (ver `personaActiva`). Se cambia
  // únicamente a mano desde el switch de Personas: ninguna fichada ni proceso
  // automático lo toca.
  activo       Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  empleado OrgEmpleado? @relation(fields: [empleado_id], references: [id], onDelete: SetNull)
  @@index([empleado_id])

  @@map("asistencia_personas")
}

// Una marca en el reloj. `fecha_hora` es el instante real (UTC) calculado desde
// la hora local del reloj (-03:00); `fecha` es el día local yyyy-mm-dd para
// filtrar y agrupar sin corrimientos. `tipo`: 0 entrada, 1 salida, 2 descanso,
// 3 horas extra (tabla Status de CrossChex). `origen`: 'reloj' (bajada directa)
// o 'crosschex' (importada del .mdb).
model AsistenciaFichada {
  id         Int      @id @default(autoincrement())
  reloj_id   Int
  user_id    String
  fecha_hora DateTime
  fecha      String
  tipo       Int      @default(0)
  modo       Int?
  work_type  Int?
  origen     String   @default("reloj")
  created_at DateTime @default(now())

  reloj AsistenciaReloj @relation(fields: [reloj_id], references: [id], onDelete: Cascade)

  @@unique([reloj_id, user_id, fecha_hora])
  @@index([fecha])
  @@index([user_id, fecha])
  @@map("asistencia_fichadas")
}

// Horario esperado de una ficha del organigrama, versionado por vigencia: una
// fila por versión, `vigente_desde`/`vigente_hasta` (inclusive, null = abierta).
// Editar desde la UI nunca pisa el pasado: "aplicar desde" cierra la versión
// vigente y crea otra. El estado de cada día se deriva al vuelo (nunca se
// guarda), así cambiar un horario no deja nada desactualizado.
// `dias`: { "0": { semanas:[0], entrada:"08:00", salida:"17:00" }, ... } con
// 0 = lunes … 6 = domingo; `semanas` son las del ciclo (0-based) en que aplica.
model AsistenciaHorario {
  id             Int      @id @default(autoincrement())
  empleado_id    Int
  vigente_desde  String // yyyy-mm-dd
  vigente_hasta  String? // yyyy-mm-dd inclusive; null = abierta
  incluir        Boolean  @default(true)
  ciclo_semanas  Int      @default(1) // 1..4
  ciclo_ancla    String // lunes yyyy-mm-dd: "semana 1" del ciclo
  tolerancia_min Int? // null = usa AsistenciaConfig
  dias           Json
  created_by     String?
  updated_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  empleado OrgEmpleado @relation(fields: [empleado_id], references: [id], onDelete: Cascade)

  @@unique([empleado_id, vigente_desde])
  @@index([empleado_id, vigente_hasta])
  @@map("asistencia_horarios")
}

// Singleton (id = 1): parámetros generales del control de asistencia.
// La tolerancia se aplica a la entrada; "tarde grave" se mide desde la hora
// pactada (no desde el fin de la tolerancia).
model AsistenciaConfig {
  id              Int      @id @default(1)
  tolerancia_min  Int      @default(10)
  tarde_grave_min Int      @default(30)
  updated_by      String?
  updated_at      DateTime @updatedAt

  @@map("asistencia_config")
}
