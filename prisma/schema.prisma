generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bonificacion {
  id             Int      @id @default(autoincrement())
  empresa        String
  titulo         String
  descripcion    String?
  mensaje_sugerido String?
  condiciones    String?
  activa         Boolean  @default(true)
  vigencia_desde String?
  vigencia_hasta String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("bonificaciones")
}

model MwproxyCatalog {
  id          Int       @id @default(autoincrement())
  mwproxy_id  Int       @unique
  name        String
  year        Int?
  available   Boolean   @default(false)
  imdb_id     String?
  imdb_rating Float?
  imdb_votes  Int?
  enriched_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("mwproxy_catalog")
}

model OnDemand {
  id          Int      @id @default(autoincrement())
  imdbID      String   @unique
  title       String
  year        String
  poster      String?
  background  String?
  logo        String?
  imdb_rating Float?
  imdb_votes  Int?
  isActive    Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("on_demand")
}

model Usuario {
  id         Int      @id @default(autoincrement())
  usuario    String   @unique
  password   String
  nombre     String?
  apellido   String?
  rol        String   @default("agente")
  isActive   Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}
