generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bonificacion {
  id             Int      @id @default(autoincrement())
  empresa        String
  titulo         String
  descripcion    String?
  mensaje_sugerido String?
  condiciones    String?
  activa         Boolean  @default(true)
  vigencia_desde String?
  vigencia_hasta String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("bonificaciones")
}

model MwproxyCatalog {
  id          Int       @id @default(autoincrement())
  mwproxy_id  Int       @unique
  name        String
  year        Int?
  available   Boolean   @default(false)
  imdb_id     String?
  imdb_rating Float?
  imdb_votes  Int?
  enriched_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("mwproxy_catalog")
}

model OnDemand {
  id          Int      @id @default(autoincrement())
  imdbID      String   @unique
  title       String
  year        String
  poster      String?
  background  String?
  logo        String?
  imdb_rating Float?
  imdb_votes  Int?
  isActive    Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("on_demand")
}

model Usuario {
  id         Int      @id @default(autoincrement())
  usuario    String   @unique
  password   String
  nombre     String?
  apellido   String?
  rol        String   @default("agente")
  isActive   Boolean  @default(true)
  modulos    String[] @default([])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}

model SportsEvent {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  synced_at        DateTime @default(now())

  @@map("sports_events")
}

model SportsFeatured {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  type             String
  borderColor      String
  synced_at        DateTime @default(now())

  @@map("sports_featured")
}

model Lead {
  id          Int      @id @default(autoincrement())
  nombre      String?
  apellido    String?
  telefono    String
  email       String?
  direccion   String?
  plan        String?
  tv_pack     Boolean? @default(false)
  origen      String
  contactado  Boolean? @default(false)
  resultado   String?
  asignado    String?
  created_at  DateTime @default(now())

  @@map("leads")
}

model PlanConfig {
  id             Int      @id @default(autoincrement())
  empresa        String   @unique
  plans          Json
  tv_addon_price Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("plan_configs")
}
