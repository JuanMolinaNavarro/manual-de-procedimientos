generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bonificacion {
  id             Int      @id @default(autoincrement())
  empresa        String
  titulo         String
  descripcion    String?
  mensaje_sugerido String?
  condiciones    String?
  activa         Boolean  @default(true)
  vigencia_desde String?
  vigencia_hasta String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("bonificaciones")
}

model MwproxyCatalog {
  id          Int       @id @default(autoincrement())
  mwproxy_id  Int       @unique
  name        String
  year        Int?
  available   Boolean   @default(false)
  imdb_id     String?
  imdb_rating Float?
  imdb_votes  Int?
  enriched_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("mwproxy_catalog")
}

model OnDemand {
  id          Int      @id @default(autoincrement())
  imdbID      String   @unique
  title       String
  year        String
  poster      String?
  background  String?
  logo        String?
  imdb_rating Float?
  imdb_votes  Int?
  isActive    Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("on_demand")
}

model Usuario {
  id         Int      @id @default(autoincrement())
  usuario    String   @unique
  password   String
  nombre     String?
  apellido   String?
  rol        String   @default("agente")
  isActive   Boolean  @default(true)
  modulos    String[] @default([])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}

model SportsEvent {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  synced_at        DateTime @default(now())

  @@map("sports_events")
}

model SportsFeatured {
  id               Int      @id @default(autoincrement())
  idEvent          String   @unique
  strEvent         String
  strHomeTeam      String?
  strAwayTeam      String?
  strHomeTeamBadge String?
  strAwayTeamBadge String?
  strThumb         String?
  strLeague        String
  strLeagueBadge   String?
  intHomeScore     String?
  intAwayScore     String?
  label            String
  labelColor       String
  timeLocal        String?
  dateFormatted    String
  type             String
  borderColor      String
  synced_at        DateTime @default(now())

  @@map("sports_featured")
}

model Lead {
  id          Int      @id @default(autoincrement())
  nombre      String?
  apellido    String?
  telefono    String
  email       String?
  direccion   String?
  plan        String?
  tv_pack     Boolean? @default(false)
  origen      String
  contactado  Boolean? @default(false)
  resultado   String?
  asignado    String?
  created_at  DateTime @default(now())

  @@map("leads")
}

model PlanConfig {
  id             Int      @id @default(autoincrement())
  empresa        String   @unique
  plans          Json
  tv_addon_price Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("plan_configs")
}

model ContratoComprador {
  id                         Int               @id @default(autoincrement())
  nombre_empresa             String
  ejecutivo_a_cargo          String?
  mail_comercial             String?
  telefono_comercial         String?
  mail_tecnico               String?
  telefono_tecnico           String?
  vigencia_desde             String?
  vigencia_hasta             String?
  precio_tipo                String?
  precio_valor               String?
  subs_minimo_garantizado    String?
  reportar_subs              Boolean           @default(false)
  plazas_reportadas          String?
  condiciones_pago_contrato  String?
  condiciones_pago_acordadas String?
  tnb_aplicada               String?
  tecnologias_autorizadas    String[]          @default([])
  logo_nombre_archivo        String?
  activa                     Boolean           @default(true)
  created_by                 String?
  updated_by                 String?
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt

  saltos_importe             SaltoImporte[]
  archivos                   ArchivoContrato[]

  @@map("contratos_comprador")
}

model ContratoVendedor {
  id                               Int               @id @default(autoincrement())
  nombre_empresa                   String
  documentacion_empresa            String?
  ejecutivo_cargo                  String?
  mail_comercial_cliente           String?
  telefono_comercial_cliente       String?
  mail_tecnico_cliente             String?
  telefono_tecnico_cliente         String?
  vigencia_desde                   String?
  vigencia_hasta                   String?
  precio_tipo                      String?
  precio_valor                     String?
  grilla                           String?
  subs_minimo_garantizado          String?
  subs_reportados_senales          String?
  plazas_incluidas_contrato        String?
  plazas_reportadas_senales        String?
  condiciones_pago                 String?
  tnb_aplicada                     String?
  forma_recepcion_entrega          String?
  equipos_por_senal                Json?
  condiciones_entrega_equipamiento String?
  logo_nombre_archivo              String?
  activa                           Boolean           @default(true)
  created_by                       String?
  updated_by                       String?
  created_at                       DateTime          @default(now())
  updated_at                       DateTime          @updatedAt

  saltos_importe                   SaltoImporte[]
  archivos                         ArchivoContrato[]

  @@map("contratos_vendedor")
}

model SaltoImporte {
  id                    Int                @id @default(autoincrement())
  contrato_comprador_id Int?
  contrato_vendedor_id  Int?
  descripcion           String
  fecha_efectiva        String
  dias_aviso_previo     Int                @default(30)
  nuevo_precio          String?
  notificado_at         DateTime?
  activa                Boolean            @default(true)
  created_by            String?
  updated_by            String?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @updatedAt

  contrato_comprador    ContratoComprador? @relation(fields: [contrato_comprador_id], references: [id])
  contrato_vendedor     ContratoVendedor?  @relation(fields: [contrato_vendedor_id], references: [id])

  @@map("saltos_importe")
}

model ArchivoContrato {
  id                    Int                @id @default(autoincrement())
  contrato_comprador_id Int?
  contrato_vendedor_id  Int?
  nombre_original       String
  nombre_archivo        String
  tipo_mime             String?
  tamano                Int?
  created_by            String?
  created_at            DateTime           @default(now())

  contrato_comprador    ContratoComprador? @relation(fields: [contrato_comprador_id], references: [id], onDelete: Cascade)
  contrato_vendedor     ContratoVendedor?  @relation(fields: [contrato_vendedor_id], references: [id], onDelete: Cascade)

  @@map("archivos_contrato")
}

model Factura {
  id                Int       @id @default(autoincrement())
  nombre_original   String
  nombre_archivo    String
  tipo_mime         String?
  tamano            Int?
  proveedor         String?
  numero_factura    String?
  fecha_emision     String?
  fecha_vencimiento String?
  monto_total       String?
  monto_iva         String?
  tipo_servicio     String?
  periodo           String?
  error_mensaje     String?
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  tipo_flujo               String?
  empresa_destino          String?
  estado_carga             String    @default("pendiente")
  finnegans_numero_interno String?
  carga_error              String?
  carga_intentos           Int       @default(0)
  carga_at                 DateTime?

  @@map("facturas")
}

// ─── Organigrama corporativo ────────────────────────────────────────────────
// Modelo híbrido: campos clave como columnas escalares (consultables/integrables)
// y el "CV" rico como columnas Json. Reemplaza las 4 claves de localStorage del
// HTML original por una única fuente de verdad compartida en Postgres.

model OrgEmpleado {
  id           Int     @id @default(autoincrement())
  nombre       String
  rol          String
  area         String // == OrgArea.nombre
  manager_id   Int?
  email        String?
  telefono     String? // interno ("phone")
  movil        String? // ("mobile")
  foto_archivo String? // filename en uploads/organigrama/fotos
  estado       String  @default("active") // active | inactive
  sede         String?
  horario      String?
  modalidad    String?
  guardias     String?
  actualizado  String?
  summary      String?
  antiguedad   String?
  formacion    String?
  seniority    String?
  especialidad String?

  // CV (Json) — espejo de las arrays del HTML
  experiencia        Json? // [{role,company,period,gray?}]
  resp_primarias     Json? // string[]
  resp_secundarias   Json? // string[]
  inputs             Json? // string[]
  outputs            Json? // string[]
  hard_skills        Json? // [{name,level,label}]
  soft_skills        Json? // [{name,rating}]
  skills             Json? // string[]
  projects           Json? // string[]
  proyectos_actuales Json? // []

  // estado del lienzo (posición libre arrastrada; null = anclado a su área)
  free_x Float?
  free_y Float?

  manager      OrgEmpleado?  @relation("OrgJerarquia", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinados OrgEmpleado[] @relation("OrgJerarquia")

  created_by String?
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("org_empleados")
}

model OrgArea {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique
  color      String   @default("#86868b")
  is_top     Boolean  @default(false)
  jefe_id    Int? // empleado jefe del área (sin relación FK formal; se limpia por código)
  parent_id  Int? // área de la que depende (sub-área); sin FK formal, se limpia por código
  pos_x      Float? // override de posición manual del área
  pos_y      Float?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("org_areas")
}

model OrgLinea {
  id         Int      @id @default(autoincrement())
  from_id    Int
  to_id      Int
  tipo       String   @default("special") // special | report-override
  estilo     String   @default("solid") // solid | dashed | dotted
  color      String   @default("#86868b")
  etiqueta   String?
  created_at DateTime @default(now())

  @@map("org_lineas")
}
