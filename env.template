# Variables de entorno del proyecto.
# Copiar como .env (docker compose) o .env.local (npm run dev) y completar los valores.
# Todo lo marcado SECRETO no se commitea nunca.

# --- Base de datos ---
# docker compose arma la DATABASE_URL del app con esta contraseña (SECRETO, obligatoria).
# Solo se aplica al crear el volumen de Postgres por primera vez.
POSTGRES_PASSWORD=
# Para `npm run dev` / Prisma CLI fuera de Docker:
DATABASE_URL=postgresql://postgres:password@localhost:5432/manualcall

# --- Primer usuario (instalación nueva) ---
# Si la tabla de usuarios está vacía, el primer login crea este usuario como superadmin
# (la contraseña se guarda cifrada). Usar una contraseña fuerte, no la de ejemplo.
SITE_USER=
SITE_PASSWORD=

# --- API externas ---
LEADS_API_KEY=           # SECRETO: header X-Api-Key de POST /api/leads
OMDB_API_KEY=
FANART_API_KEY=
MWPROXY_BASE_URL=
MWPROXY_TOKEN=
ISPBOSS_API_KEY=         # SECRETO: API de ISPBoss (Carga de ventas)
ISPBOSS_BASE_URL=https://viaccc.ispboss.com

# --- Recibos de Finnegans (API Teamplace) ---
TEAMPLACE_CLIENT_ID=
TEAMPLACE_CLIENT_SECRET= # SECRETO
FINNEGANS_RECIBO_XML=           # opcional (default ReciboSueldosOficial.jrxml)
FINNEGANS_RECIBO_DATASOURCE=    # opcional (default F_GA_LIQ_0065)
FINNEGANS_TOPE_MENSUAL=         # opcional (default 80 llamadas pagas por mes)

# --- Aviso por mail de recibos ---
# Sin SMTP_HOST = modo prueba: los mails se guardan como .eml en uploads/nomina/mails-prueba/.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=             # true | false
SMTP_USER=
SMTP_PASS=               # SECRETO
MAIL_FROM="Recursos Humanos <rrhh@empresa>"
APP_URL=                 # base del enlace a Mis recibos (default http://localhost:3000)

# --- Operación ---
CRON_ENABLED=            # 1 = correr los crons también en desarrollo; 0 = apagarlos siempre (copias de prueba)
PRISMA_ACCEPT_DATA_LOSS= # 1 = solo para un deploy con cambios destructivos del schema ya revisados
