# Variables de entorno para el proyecto
# Copiar este archivo como .env o .env.local y configurar los valores

# Contraseña para acceder al panel de administración
# IMPORTANTE: Cambiar esta contraseña en producción
ADMIN_PASSWORD=admin123

# Usuario y contrase??a para acceder al sitio
SITE_USER=agente01
SITE_PASSWORD=clave123

# Cadena de conexión a PostgreSQL para Prisma
DATABASE_URL=postgresql://usuario:password@localhost:5432/esquema_retencion

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Worker Python: extracción + carga en FinnegansGO ---
# Secreto compartido entre el backend y el worker (header X-Worker-Key). Requerido.
WORKER_SECRET=cambiar-este-secreto
# Empresa destino forzada (sandbox). Vacío = auto-detección por NUM_SERVICIO.
WORKER_EMPRESA=
# Segundos entre polls del worker.
WORKER_POLL_INTERVAL=15
# Reinicia el navegador cada N facturas (0 lo desactiva). La extracción es 100%
# determinista (sin IA), así que ya NO se necesita OPENAI_API_KEY.
WORKER_RESTART_EVERY=5
# Credenciales de FinnegansGO.
FINNEGANS_USER=
FINNEGANS_PASS=
FINNEGANS_WORKSPACE=MULTIMEDIOS
